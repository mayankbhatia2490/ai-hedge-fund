FROM node:20-slim

WORKDIR /app

COPY app/frontend/package.json app/frontend/package-lock.json* app/frontend/pnpm-lock.yaml* ./

RUN npm install

COPY app/frontend/ ./

ARG VITE_API_URL=http://localhost:8080
ENV VITE_API_URL=${VITE_API_URL}

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0", "--port", "5173"]
